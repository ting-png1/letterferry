{
  "manifest_version": 3,
  "name": "LetterFerry · 渡信 (Local Lab)",
  "version": "0.4.3",
  "description": "Local opt-in Weixin to ChatGPT bridge; developer preview.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8799/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LetterFerry · 渡信"
  }
}
